# Copy to /srv/mazaoyako/.env and chmod 600. Use unique random values.
NODE_ENV=production
API_PORT=4102
APP_ORIGINS=https://mazaoyako.co.ke
TRUSTED_PROXY_IPS=172.26.0.1

# Generate once with: openssl rand -hex 32. Keep stable across restarts.
CREDENTIAL_FINGERPRINT_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET

DB_NAME=mazaoyako
DB_USER=mazaoyako_app
DB_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
DATABASE_URL=postgresql://mazaoyako_app:REPLACE_WITH_64_HEX_CHAR_SECRET@db:5432/mazaoyako

# Exact full commit SHA published by the main CI workflow.
MAZAO_API_IMAGE=ghcr.io/davemusau00/mazao-erp-v1/api:REPLACE_WITH_COMMIT_SHA
