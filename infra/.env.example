# Example only. Create /srv/mazao/.env on the host and chmod 600.
# Generate a long random DB_PASSWORD; it is URL-safe because it uses hex.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4101
APP_ORIGINS=https://mazao.davemusau.co.ke

DB_NAME=mazao
DB_USER=mazao_app
DB_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
DATABASE_URL=postgresql://mazao_app:REPLACE_WITH_64_HEX_CHAR_SECRET@db:5432/mazao

# The CI workflow publishes the image tagged with the full Git commit SHA.
MAZAO_API_IMAGE=ghcr.io/davemusau00/mazao-erp-v1/api:REPLACE_WITH_COMMIT_SHA
